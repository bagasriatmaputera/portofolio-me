<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2e3d56"/>
      <stop offset="100%" stop-color="#10161e"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.04"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bgGrad)"/>
  <!-- Window mockup -->
  <rect x="50" y="40" width="700" height="370" rx="16" fill="url(#cardGrad)" stroke="#c1988b" stroke-opacity="0.2" stroke-width="2"/>
  <circle cx="80" cy="70" r="6" fill="#ff5f56"/>
  <circle cx="100" cy="70" r="6" fill="#ffbd2e"/>
  <circle cx="120" cy="70" r="6" fill="#27c93f"/>
  <line x1="50" y1="95" x2="750" y2="95" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1.5"/>
  <!-- UI Mockup Wireframe -->
  <rect x="80" y="125" width="200" height="240" rx="10" fill="#ffffff" fill-opacity="0.05"/>
  <rect x="305" y="125" width="415" height="110" rx="10" fill="#808849" fill-opacity="0.2"/>
  <rect x="305" y="255" width="200" height="110" rx="10" fill="#c1988b" fill-opacity="0.15"/>
  <rect x="520" y="255" width="200" height="110" rx="10" fill="#ffffff" fill-opacity="0.08"/>
  <text x="400" y="40" text-anchor="middle" fill="#e0e6ee" font-family="sans-serif" font-size="14" font-weight="600" opacity="0.8">Preview Project</text>
</svg>
